{
  "$id": "urn:gew:schema:stage-diagnostic:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "capabilities": {
      "properties": {
        "install-apply": {
          "const": "unavailable"
        },
        "install-plan": {
          "const": "available"
        },
        "release": {
          "const": "unavailable"
        },
        "reopen-staged": {
          "const": "unavailable"
        },
        "stage": {
          "const": "unavailable"
        }
      },
      "required": [
        "install-plan",
        "install-apply",
        "stage",
        "reopen-staged",
        "release"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "checks": {
      "items": {
        "properties": {
          "code": {
            "enum": [
              "ok",
              "input_invalid",
              "trust_rejected",
              "closure_mismatch",
              "resource_limit",
              "platform_unavailable",
              "currentness",
              "clock_unavailable",
              "authority_required",
              "quiescence",
              "pmf_export_blocked",
              "recovery_blocked",
              "phase_unavailable"
            ]
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "ref": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "blocked",
              "rejected"
            ]
          }
        },
        "required": [
          "id",
          "status",
          "code",
          "ref"
        ],
        "type": "object",
        "unevaluatedProperties": false
      },
      "maxItems": 65536,
      "type": "array"
    },
    "code": {
      "enum": [
        "ok",
        "input_invalid",
        "trust_rejected",
        "closure_mismatch",
        "resource_limit",
        "platform_unavailable",
        "currentness",
        "clock_unavailable",
        "authority_required",
        "quiescence",
        "pmf_export_blocked",
        "recovery_blocked",
        "phase_unavailable"
      ]
    },
    "diagnostic_digest": {
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$",
      "type": "string"
    },
    "next_route": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "phase": {
      "enum": [
        "plan",
        "stage"
      ]
    },
    "refs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 65536,
      "type": "array",
      "uniqueItems": true
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "blocked",
        "rejected"
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "status",
    "phase",
    "code",
    "checks",
    "refs",
    "capabilities",
    "next_route",
    "diagnostic_digest"
  ],
  "type": "object",
  "unevaluatedProperties": false
}
