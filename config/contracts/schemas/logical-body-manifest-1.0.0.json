{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:logical-body-manifest:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "mode": {"enum": ["compact", "emergency", "full"]},
    "physical_body_digest": {"type": "string", "minLength": 78, "maxLength": 78},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "object", "minProperties": 6, "maxProperties": 6, "additionalProperties": true}
    },
    "manifest_digest": {"type": "string", "minLength": 78, "maxLength": 78}
  },
  "required": ["schema_version", "manifest_id", "mode", "physical_body_digest", "entries", "manifest_digest"],
  "unevaluatedProperties": false
}
