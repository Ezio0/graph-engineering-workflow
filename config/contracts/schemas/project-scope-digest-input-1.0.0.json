{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:project-scope-digest-input:1.0.0",
  "$defs": {
    "id": {"type": "string", "format": "gew-id"},
    "digest": {"type": "string", "minLength": 78, "maxLength": 78},
    "ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "repository": {
      "type": "object",
      "properties": {
        "binding_id": {"$ref": "#/$defs/id"},
        "mode": {"enum": ["create_new", "attach_existing"]},
        "vcs": {"const": "git"},
        "canonical_identity": {"type": ["string", "null"], "format": "gew-id"},
        "planned_target_id": {"type": ["string", "null"], "format": "gew-id"},
        "allowed_path_boundary": {"$ref": "#/$defs/id"},
        "default_branch_ref": {"$ref": "#/$defs/id"},
        "command_refs": {"$ref": "#/$defs/ids"}
      },
      "required": ["binding_id", "mode", "vcs", "canonical_identity", "planned_target_id", "allowed_path_boundary", "default_branch_ref", "command_refs"],
      "unevaluatedProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "binding_id": {"$ref": "#/$defs/id"},
        "repository_id": {"$ref": "#/$defs/id"},
        "component_refs": {"$ref": "#/$defs/ids"},
        "capability_refs": {"$ref": "#/$defs/ids"},
        "dependency_refs": {"$ref": "#/$defs/ids"},
        "target_state_contract_ref": {"$ref": "#/$defs/id"}
      },
      "required": ["binding_id", "repository_id", "component_refs", "capability_refs", "dependency_refs", "target_state_contract_ref"],
      "unevaluatedProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "binding_id": {"$ref": "#/$defs/id"},
        "kind": {"$ref": "#/$defs/id"},
        "canonical_identity": {"$ref": "#/$defs/id"},
        "service_ids": {"$ref": "#/$defs/ids"},
        "sensitivity": {"enum": ["public", "internal", "confidential", "secret"]},
        "operation_classes": {"$ref": "#/$defs/ids"},
        "target_state_validator_ref": {"$ref": "#/$defs/id"}
      },
      "required": ["binding_id", "kind", "canonical_identity", "service_ids", "sensitivity", "operation_classes", "target_state_validator_ref"],
      "unevaluatedProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "target_id": {"$ref": "#/$defs/id"},
        "acceptance_id": {"$ref": "#/$defs/id"},
        "repository_ids": {"$ref": "#/$defs/ids"},
        "service_ids": {"$ref": "#/$defs/ids"},
        "environment_ids": {"$ref": "#/$defs/ids"},
        "resource_ids": {"$ref": "#/$defs/ids"},
        "required_final_state": {"$ref": "#/$defs/id"},
        "verification_contract_ref": {"$ref": "#/$defs/id"}
      },
      "required": ["target_id", "acceptance_id", "repository_ids", "service_ids", "environment_ids", "resource_ids", "required_final_state", "verification_contract_ref"],
      "unevaluatedProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scope_id": {"$ref": "#/$defs/id"},
    "version": {"type": "integer", "minimum": 1},
    "mode": {"const": "create-or-attach"},
    "repositories": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/repository"}},
    "services": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/service"}},
    "environments": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/environment"}},
    "target_bindings": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/target"}},
    "discovery_digest": {"$ref": "#/$defs/digest"}
  },
  "required": ["schema_version", "scope_id", "version", "mode", "repositories", "services", "environments", "target_bindings", "discovery_digest"],
  "unevaluatedProperties": false
}
