{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:redaction-policy:1.0.0",
  "$defs": {"digest": {"type": "string", "minLength": 78, "maxLength": 78}},
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string", "format": "gew-id"},
    "allowed_transforms": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "format": "gew-id"}},
    "mask_marker": {"type": "string", "minLength": 1, "maxLength": 128},
    "max_fields": {"type": "integer", "minimum": 1},
    "policy_digest": {"$ref": "#/$defs/digest"}
  },
  "required": ["schema_version", "policy_id", "allowed_transforms", "mask_marker", "max_fields", "policy_digest"],
  "unevaluatedProperties": false
}
