{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:retention-policy-registry:1.0.0",
  "$defs": {
    "digest": {"type": "string", "minLength": 78, "maxLength": 78},
    "policy": {
      "type": "object",
      "properties": {
        "category": {"type": "string", "format": "gew-id"},
        "max_age_seconds": {"type": "integer", "minimum": 0},
        "purge_triggers": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "format": "gew-id"}},
        "tombstone_required": {"type": "boolean"},
        "purge_after_extraction": {"type": "boolean"}
      },
      "required": ["category", "max_age_seconds", "purge_triggers", "tombstone_required", "purge_after_extraction"],
      "unevaluatedProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"type": "string", "format": "gew-id"},
    "policies": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/policy"}},
    "registry_digest": {"$ref": "#/$defs/digest"}
  },
  "required": ["schema_version", "registry_id", "policies", "registry_digest"],
  "unevaluatedProperties": false
}
