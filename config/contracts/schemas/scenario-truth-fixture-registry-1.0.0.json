{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:scenario-truth-fixture-registry:1.0.0",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$"
    },
    "raw": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "optional_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "incident_signal": {"type": "object", "properties": {"signal_id": {"$ref": "#/$defs/id"}, "observed_epoch": {"$ref": "#/$defs/integer"}, "current_epoch": {"$ref": "#/$defs/integer"}, "max_age_epochs": {"$ref": "#/$defs/integer"}}, "required": ["signal_id", "observed_epoch", "current_epoch", "max_age_epochs"], "unevaluatedProperties": false},
    "incident_unaffected": {"type": "object", "properties": {"observation_id": {"$ref": "#/$defs/id"}, "value_digest": {"$ref": "#/$defs/digest"}}, "required": ["observation_id", "value_digest"], "unevaluatedProperties": false},
    "incident_service": {"type": "object", "properties": {"predicate_id": {"$ref": "#/$defs/id"}, "value_digest": {"$ref": "#/$defs/digest"}, "observed_epoch": {"$ref": "#/$defs/integer"}, "current_epoch": {"$ref": "#/$defs/integer"}, "max_age_epochs": {"$ref": "#/$defs/integer"}}, "required": ["predicate_id", "value_digest", "observed_epoch", "current_epoch", "max_age_epochs"], "unevaluatedProperties": false},
    "incident_contained_input": {"type": "object", "properties": {"state_id": {"$ref": "#/$defs/id"}, "authority_id": {"$ref": "#/$defs/id"}, "fence_id": {"$ref": "#/$defs/id"}, "residual_state_id": {"$ref": "#/$defs/id"}, "action_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "inner_outcome": {"$ref": "#/$defs/id"}}, "required": ["state_id", "authority_id", "fence_id", "residual_state_id", "action_ids", "inner_outcome"], "unevaluatedProperties": false},
    "incident_contract": {
      "type": "object",
      "properties": {
        "contract_id": {"$ref": "#/$defs/id"},
        "effect_classification": {"enum": ["known", "unknown"]},
        "gate_ids": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["detection", "containment", "recovery", "owner-route"]}},
        "signal": {"$ref": "#/$defs/incident_signal"},
        "impact_roles": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "severity": {"$ref": "#/$defs/id"},
        "affected_roles": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "unaffected_observations": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/incident_unaffected"}},
        "authority_id": {"$ref": "#/$defs/optional_id"},
        "fence_id": {"$ref": "#/$defs/optional_id"},
        "residual_state_id": {"$ref": "#/$defs/id"},
        "action_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "forbidden_action_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "compensation_id": {"$ref": "#/$defs/optional_id"},
        "original_action_id": {"$ref": "#/$defs/id"},
        "service_predicates": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/incident_service"}},
        "follow_up_id": {"$ref": "#/$defs/optional_id"},
        "contained_input": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/incident_contained_input"}]},
        "unknown_claim_id": {"$ref": "#/$defs/optional_id"},
        "owner_route": {"$ref": "#/$defs/id"},
        "expected_outcome": {"$ref": "#/$defs/id"}
      },
      "required": ["contract_id", "effect_classification", "gate_ids", "signal", "impact_roles", "severity", "affected_roles", "unaffected_observations", "authority_id", "fence_id", "residual_state_id", "action_ids", "forbidden_action_ids", "compensation_id", "original_action_id", "service_predicates", "follow_up_id", "contained_input", "unknown_claim_id", "owner_route", "expected_outcome"],
      "unevaluatedProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "$ref": "#/$defs/id"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "fixture_id": {
            "$ref": "#/$defs/id"
          },
          "profile_id": {
            "$ref": "#/$defs/id"
          },
          "scenario_id": {
            "$ref": "#/$defs/id"
          },
          "rejection_attack_ids": {
            "type": "array",
            "maxItems": 64,
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "target_roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "properties": {
                "role_id": {
                  "$ref": "#/$defs/id"
                },
                "path_id": {
                  "$ref": "#/$defs/id"
                },
                "baseline_state_id": {
                  "$ref": "#/$defs/id"
                },
                "baseline_value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "candidate_state_id": {
                  "$ref": "#/$defs/id"
                },
                "candidate_value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "rollback_state_id": {
                  "$ref": "#/$defs/id"
                },
                "rollback_value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                }
              },
              "required": [
                "role_id",
                "path_id",
                "baseline_state_id",
                "baseline_value",
                "candidate_state_id",
                "candidate_value",
                "rollback_state_id",
                "rollback_value"
              ],
              "unevaluatedProperties": false
            }
          },
          "phase_expectations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "phase_id": {
                  "$ref": "#/$defs/id"
                },
                "from_state_id": {
                  "$ref": "#/$defs/id"
                },
                "to_state_id": {
                  "$ref": "#/$defs/id"
                }
              },
              "required": [
                "phase_id",
                "from_state_id",
                "to_state_id"
              ],
              "unevaluatedProperties": false
            }
          },
          "assertion_expectations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "properties": {
                "assertion_id": {
                  "$ref": "#/$defs/id"
                },
                "kind": {
                  "$ref": "#/$defs/id"
                },
                "expected": {
                  "type": [
                    "string",
                    "integer",
                    "boolean"
                  ]
                }
              },
              "required": [
                "assertion_id",
                "kind",
                "expected"
              ],
              "unevaluatedProperties": false
            }
          },
          "rollback_or_compensation": {
            "type": "object",
            "properties": {
              "kind": {
                "$ref": "#/$defs/id"
              },
              "expected_state_id": {
                "$ref": "#/$defs/id"
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "expected_state_id",
              "required"
            ],
            "unevaluatedProperties": false
          },
          "fixture_digest": {
            "$ref": "#/$defs/digest"
          },
          "incident_contract": {
            "$ref": "#/$defs/incident_contract"
          },
          "execution_contract": {
            "type": "object",
            "properties": {
              "contract_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "environment_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "environment_classification": {
                "const": "non-production"
              },
              "authority_kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "impact_roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "minItems": 1,
                "maxItems": 64
              },
              "containment_roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "minItems": 1,
                "maxItems": 64
              },
              "controls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "control_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "kind": {
                      "enum": [
                        "authority",
                        "impact",
                        "containment",
                        "health",
                        "rollback"
                      ]
                    },
                    "path_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "expected_value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  },
                  "required": [
                    "control_id",
                    "kind",
                    "path_id",
                    "expected_value"
                  ],
                  "unevaluatedProperties": false
                },
                "minItems": 5,
                "maxItems": 5
              },
              "minimal_change_budget": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "health_predicates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "predicate_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "target_role": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "field_path": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "minItems": 1,
                      "maxItems": 64
                    },
                    "expected": {
                      "type": [
                        "string",
                        "boolean",
                        "integer",
                        "null"
                      ],
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "predicate_id",
                    "target_role",
                    "field_path",
                    "expected"
                  ],
                  "unevaluatedProperties": false
                },
                "minItems": 1,
                "maxItems": 64
              },
              "ordered_gates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "gate_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "kind": {
                      "enum": [
                        "impact",
                        "health",
                        "rollback"
                      ]
                    }
                  },
                  "required": [
                    "gate_id",
                    "kind"
                  ],
                  "unevaluatedProperties": false
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "contract_id",
              "environment_id",
              "environment_classification",
              "authority_kind",
              "impact_roles",
              "containment_roles",
              "controls",
              "minimal_change_budget",
              "health_predicates",
              "ordered_gates"
            ],
            "unevaluatedProperties": false
          },
          "refactor_contract": {
            "type": "object",
            "properties": {
              "contract_id": {
                "$ref": "#/$defs/id"
              },
              "environment_id": {
                "$ref": "#/$defs/id"
              },
              "gate_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "behavior-equivalence",
                    "architecture-invariant",
                    "nonfunctional-target"
                  ]
                }
              },
              "behavior_cases": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "properties": {
                    "case_id": {
                      "$ref": "#/$defs/id"
                    },
                    "input_digest": {
                      "$ref": "#/$defs/digest"
                    },
                    "output_digest": {
                      "$ref": "#/$defs/digest"
                    },
                    "error_digest": {
                      "$ref": "#/$defs/digest"
                    },
                    "side_effect_digest": {
                      "$ref": "#/$defs/digest"
                    }
                  },
                  "required": [
                    "case_id",
                    "input_digest",
                    "output_digest",
                    "error_digest",
                    "side_effect_digest"
                  ],
                  "unevaluatedProperties": false
                }
              },
              "required_edges": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "properties": {
                    "from_path_id": {
                      "$ref": "#/$defs/id"
                    },
                    "to_path_id": {
                      "$ref": "#/$defs/id"
                    }
                  },
                  "required": [
                    "from_path_id",
                    "to_path_id"
                  ],
                  "unevaluatedProperties": false
                }
              },
              "forbidden_edges": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "properties": {
                    "from_path_id": {
                      "$ref": "#/$defs/id"
                    },
                    "to_path_id": {
                      "$ref": "#/$defs/id"
                    }
                  },
                  "required": [
                    "from_path_id",
                    "to_path_id"
                  ],
                  "unevaluatedProperties": false
                }
              },
              "nonfunctional_target": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "environment_id": {
                    "$ref": "#/$defs/id"
                  },
                  "metric_id": {
                    "$ref": "#/$defs/id"
                  },
                  "comparator": {
                    "enum": [
                      "equal",
                      "greater-than",
                      "greater-than-or-equal",
                      "less-than",
                      "less-than-or-equal"
                    ]
                  },
                  "threshold": {
                    "$ref": "#/$defs/integer"
                  }
                },
                "required": [
                  "environment_id",
                  "metric_id",
                  "comparator",
                  "threshold"
                ],
                "unevaluatedProperties": false
              }
            },
            "required": [
              "contract_id",
              "environment_id",
              "gate_ids",
              "behavior_cases",
              "required_edges",
              "forbidden_edges",
              "nonfunctional_target"
            ],
            "unevaluatedProperties": false
          }
        },
        "required": [
          "fixture_id",
          "profile_id",
          "scenario_id",
          "target_roles",
          "phase_expectations",
          "assertion_expectations",
          "rollback_or_compensation",
          "fixture_digest"
        ],
        "unevaluatedProperties": false
      }
    },
    "registry_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "required": [
    "schema_version",
    "registry_id",
    "fixtures",
    "registry_digest"
  ],
  "unevaluatedProperties": false
}
