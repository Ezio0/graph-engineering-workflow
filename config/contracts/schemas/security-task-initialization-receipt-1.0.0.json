{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:security-task-initialization-receipt:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "format": "gew-id"
    },
    "request_id": {
      "type": "string",
      "format": "gew-id"
    },
    "initial_task_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$"
    },
    "installation_receipt_digest": {
      "type": "string",
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$"
    },
    "initial_snapshot_digest": {
      "type": "string",
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$"
    },
    "initial_state_digest": {
      "type": "string",
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$"
    },
    "identity_digest": {
      "type": "string",
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$"
    },
    "baseline_refs_digest": {
      "type": "string",
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$"
    },
    "scope_approval_digest": {
      "type": "string",
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$"
    },
    "receipt_digest": {
      "type": "string",
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "request_id",
    "initial_task_revision",
    "request_digest",
    "installation_receipt_digest",
    "initial_snapshot_digest",
    "initial_state_digest",
    "identity_digest",
    "baseline_refs_digest",
    "scope_approval_digest",
    "receipt_digest"
  ],
  "unevaluatedProperties": false
}
