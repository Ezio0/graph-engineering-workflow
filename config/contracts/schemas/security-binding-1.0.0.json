{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:security-binding:1.0.0",
  "$defs": {
    "id": {"type": "string", "format": "gew-id"},
    "digest": {"type": "string", "minLength": 78, "maxLength": 78},
    "target": {
      "type": "object",
      "properties": {
        "target_id": {"$ref": "#/$defs/id"},
        "target_kind": {"$ref": "#/$defs/id"},
        "canonical_identity": {"$ref": "#/$defs/id"},
        "target_digest": {"$ref": "#/$defs/digest"}
      },
      "required": ["target_id", "target_kind", "canonical_identity", "target_digest"],
      "unevaluatedProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"$ref": "#/$defs/id"},
    "owner_id": {"$ref": "#/$defs/id"},
    "runtime_kind": {"$ref": "#/$defs/id"},
    "runtime_lineage_id": {"$ref": "#/$defs/id"},
    "scope_id": {"$ref": "#/$defs/id"},
    "scope_digest": {"$ref": "#/$defs/digest"},
    "baselines": {"type": "object", "minProperties": 1, "maxProperties": 16, "additionalProperties": {"$ref": "#/$defs/digest"}},
    "snapshot_digest": {"$ref": "#/$defs/digest"},
    "targets": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/target"}},
    "binding_digest": {"$ref": "#/$defs/digest"}
  },
  "required": ["schema_version", "task_id", "owner_id", "runtime_kind", "runtime_lineage_id", "scope_id", "scope_digest", "baselines", "snapshot_digest", "targets", "binding_digest"],
  "unevaluatedProperties": false
}
