{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:artifact-contract-registry:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "contracts": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"type": "object", "minProperties": 14, "maxProperties": 14, "additionalProperties": true}
    },
    "registry_digest": {"type": "string", "minLength": 78, "maxLength": 78}
  },
  "required": ["schema_version", "registry_id", "contracts", "registry_digest"],
  "unevaluatedProperties": false
}
