{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:release-operations-observation-input:1.0.0",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$"
    },
    "raw": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ids": {
      "type": "array",
      "maxItems": 16384,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "openObject": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "additionalProperties": true
    },
    "currentTarget": {
      "type": "object",
      "properties": {
        "target_id": {"$ref": "#/$defs/id"},
        "target_digest": {"$ref": "#/$defs/digest"},
        "resource_id": {"$ref": "#/$defs/id"},
        "fresh": {"const": true},
        "observation_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "state": {
          "type": "object",
          "properties": {
            "generation": {"$ref": "#/$defs/integer"},
            "active_artifact_digest": {"$ref": "#/$defs/digest"},
            "staged_artifact_digest": {
              "anyOf": [
                {"type": "null"},
                {"$ref": "#/$defs/digest"}
              ]
            }
          },
          "required": ["generation", "active_artifact_digest", "staged_artifact_digest"],
          "unevaluatedProperties": false
        }
      },
      "required": ["target_id", "target_digest", "resource_id", "fresh", "observation_revision", "state"],
      "unevaluatedProperties": false
    },
    "scalar": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "maxLength": 4096
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "evidence_kind": {
      "const": "authoritative-local-release-simulator"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "snapshot_digest": {
      "$ref": "#/$defs/digest"
    },
    "invalidation_epoch": {
      "$ref": "#/$defs/integer"
    },
    "profile_id": {
      "const": "release-operations"
    },
    "profile_version": {
      "const": "1.0.0"
    },
    "graph_ref_pins": {
      "$ref": "#/$defs/openObject"
    },
    "installation_pins": {
      "$ref": "#/$defs/openObject"
    },
    "artifact_manifest": {
      "$ref": "urn:gew:schema:release-artifact-manifest:1.0.0"
    },
    "artifact_manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "deployment_observation": {
      "$ref": "urn:gew:schema:release-deployment-observation:1.0.0"
    },
    "deployment_observation_digest": {
      "$ref": "#/$defs/digest"
    },
    "health_observation": {
      "$ref": "urn:gew:schema:release-health-observation:1.0.0"
    },
    "health_observation_digest": {
      "$ref": "#/$defs/digest"
    },
    "rollback_observation": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "urn:gew:schema:release-deployment-observation:1.0.0"}
      ]
    },
    "rollback_observation_digest": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/digest"}
      ]
    },
    "current_target": {
      "$ref": "#/$defs/currentTarget"
    },
    "current_target_digest": {
      "$ref": "#/$defs/digest"
    },
    "claim_id": {
      "$ref": "#/$defs/id"
    },
    "receipt_digest": {
      "$ref": "#/$defs/digest"
    },
    "owner_route": {
      "$ref": "#/$defs/id"
    },
    "column_id": {
      "$ref": "#/$defs/id"
    },
    "scenario_id": {
      "$ref": "#/$defs/id"
    },
    "outcome": {
      "$ref": "#/$defs/id"
    }
  },
  "required": [
    "schema_version",
    "evidence_kind",
    "task_id",
    "task_revision",
    "snapshot_digest",
    "invalidation_epoch",
    "profile_id",
    "profile_version",
    "graph_ref_pins",
    "installation_pins",
    "artifact_manifest",
    "artifact_manifest_digest",
    "deployment_observation",
    "deployment_observation_digest",
    "health_observation",
    "health_observation_digest",
    "rollback_observation",
    "rollback_observation_digest",
    "current_target",
    "current_target_digest",
    "claim_id",
    "receipt_digest",
    "owner_route",
    "column_id",
    "scenario_id",
    "outcome"
  ],
  "unevaluatedProperties": false
}
