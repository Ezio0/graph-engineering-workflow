{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:evidence-policy-registry:1.0.0",
  "$defs": {
    "digest": {"type": "string", "minLength": 78, "maxLength": 78},
    "policy": {
      "type": "object",
      "properties": {
        "evidence_type": {"type": "string", "format": "gew-id"},
        "maximum_freshness_seconds": {"type": "integer", "minimum": 0},
        "minimum_trust": {"enum": ["untrusted", "validated", "independently-reviewed"]},
        "maximum_sensitivity": {"enum": ["public", "internal", "confidential", "secret"]}
      },
      "required": ["evidence_type", "maximum_freshness_seconds", "minimum_trust", "maximum_sensitivity"],
      "unevaluatedProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"type": "string", "format": "gew-id"},
    "policies": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/policy"}},
    "registry_digest": {"$ref": "#/$defs/digest"}
  },
  "required": ["schema_version", "registry_id", "policies", "registry_digest"],
  "unevaluatedProperties": false
}
