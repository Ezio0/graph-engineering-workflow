{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:loop-budget-registry:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "budgets": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "urn:gew:schema:loop-budget:1.0.0"}}
