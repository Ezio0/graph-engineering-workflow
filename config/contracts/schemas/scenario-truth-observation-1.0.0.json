        "profile_version",
        "scenario_id",
        "fixture_id",
        "fixture_digest",
        "required_target_roles",
        "ordered_phase_ids",
        "required_fact_ids",
        "success_outcome",
        "blocked_outcome",
        "owner_route_policy",
        "branch_isolation_policy",
        "mutation_budget",
        "rollback_required",
        "compensation_required",
        "row_digest"
