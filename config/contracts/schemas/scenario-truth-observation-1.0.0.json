{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:scenario-truth-observation:1.0.0",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
