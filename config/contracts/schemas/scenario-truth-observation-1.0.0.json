            "rollback_value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
              }
            },
            "required": [
              "role_id",
              "path_id",
              "baseline_state_id",
              "baseline_value",
              "candidate_state_id",
              "candidate_value",
              "rollback_state_id",
              "rollback_value"
