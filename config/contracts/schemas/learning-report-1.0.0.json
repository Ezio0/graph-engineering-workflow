{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:learning-report:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "cohort_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "eligible_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unknown_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rules": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "numerator": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "denominator": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unknown_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "verdict": {
            "enum": [
              "supports",
              "counter-evidence",
              "insufficient-data",
              "mixed"
            ]
          }
        },
        "required": [
          "rule_id",
          "numerator",
          "denominator",
          "unknown_count",
          "verdict"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "policy_digest",
    "experiment_id",
    "cohort_digest",
    "eligible_count",
    "unknown_count",
    "rules"
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false
}
