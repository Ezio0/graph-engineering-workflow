{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:release-simulator-fixture-registry:1.0.0",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$"
    },
    "raw": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ids": {
      "type": "array",
      "maxItems": 16384,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "openObject": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "additionalProperties": true
    },
    "scalar": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "maxLength": 4096
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "$ref": "#/$defs/id"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "fixture_id": {
            "$ref": "#/$defs/id"
          },
          "stage_relative_path": {
            "$ref": "#/$defs/id"
          },
          "active_relative_path": {
            "$ref": "#/$defs/id"
          },
          "state_relative_path": {
            "$ref": "#/$defs/id"
          },
          "artifact_vectors": {
            "type": "array",
            "minItems": 2,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "$ref": "#/$defs/id"
                },
                "artifact_version": {
                  "$ref": "#/$defs/id"
                },
                "artifact_base64": {
                  "$ref": "#/$defs/id"
                },
                "distribution_name": {
                  "$ref": "#/$defs/id"
                },
                "distribution_version": {
                  "$ref": "#/$defs/id"
                }
              },
              "required": [
                "artifact_id",
                "artifact_version",
                "artifact_base64",
                "distribution_name",
                "distribution_version"
              ],
              "unevaluatedProperties": false
            }
          },
          "fault_schedule": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "fault_point": {
                  "$ref": "#/$defs/id"
                },
                "result_class": {
                  "$ref": "#/$defs/id"
                }
              },
              "required": [
                "fault_point",
                "result_class"
              ],
              "unevaluatedProperties": false
            }
          },
          "expected_rollback_artifact_id": {
            "$ref": "#/$defs/id"
          }
        },
        "required": [
          "fixture_id",
          "stage_relative_path",
          "active_relative_path",
          "state_relative_path",
          "artifact_vectors",
          "fault_schedule",
          "expected_rollback_artifact_id"
        ],
        "unevaluatedProperties": false
      }
    },
    "registry_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "required": [
    "schema_version",
    "registry_id",
    "fixtures",
    "registry_digest"
  ],
  "unevaluatedProperties": false
}
