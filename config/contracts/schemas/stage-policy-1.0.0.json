{
  "$id": "urn:gew:schema:stage-policy:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "installer_policy_digest": {
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$",
      "type": "string"
    },
    "max_cleanup_entries": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "max_failed_candidates": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "max_output_bytes": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "max_process_seconds": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "max_stage_bytes": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "max_stage_files": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "policy_digest": {
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$",
      "type": "string"
    },
    "policy_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "installer_policy_digest",
    "max_stage_bytes",
    "max_stage_files",
    "max_process_seconds",
    "max_output_bytes",
    "max_failed_candidates",
    "max_cleanup_entries",
    "policy_digest"
  ],
  "type": "object",
  "unevaluatedProperties": false
}
