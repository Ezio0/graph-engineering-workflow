{
  "$id": "urn:gew:schema:stage-execution-binding:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "challenge_digest": {
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$",
      "type": "string"
    },
    "envelope_digest": {
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$",
      "type": "string"
    },
    "execution_binding_digest": {
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$",
      "type": "string"
    },
    "installation_id": {
      "minLength": 1,
      "type": "string"
    },
    "operation": {
      "const": "install"
    },
    "plan_digest": {
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "stage_context_digest": {
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "installation_id",
    "request_id",
    "operation",
    "plan_digest",
    "stage_context_digest",
    "envelope_digest",
    "challenge_digest",
    "execution_binding_digest"
  ],
  "type": "object",
  "unevaluatedProperties": false
}
