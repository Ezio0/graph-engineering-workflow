{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:disclosure-receipt:1.0.0",
  "$defs": {"id": {"type": "string", "format": "gew-id"}, "digest": {"type": "string", "minLength": 78, "maxLength": 78}},
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "payload_digest": {"$ref": "#/$defs/digest"},
    "destination_identity_ref": {"$ref": "#/$defs/id"},
    "occurred_at": {"type": "string", "format": "gew-timestamp"},
    "result": {"enum": ["delivered", "failed", "unknown"]},
    "target_receipt_digest": {"$ref": "#/$defs/digest"},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "required": ["schema_version", "receipt_id", "plan_digest", "payload_digest", "destination_identity_ref", "occurred_at", "result", "target_receipt_digest", "receipt_digest"],
  "unevaluatedProperties": false
}
