{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:scenario-truth-fixture-registry-input:1.0.0",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$"
    },
    "raw": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "$ref": "#/$defs/id"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "fixture_id": {
            "$ref": "#/$defs/id"
          },
          "profile_id": {
            "$ref": "#/$defs/id"
          },
          "scenario_id": {
            "$ref": "#/$defs/id"
          },
          "rejection_attack_ids": {
            "type": "array",
            "maxItems": 64,
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "target_roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "properties": {
                "role_id": {
                  "$ref": "#/$defs/id"
                },
                "path_id": {
                  "$ref": "#/$defs/id"
                },
                "baseline_state_id": {
                  "$ref": "#/$defs/id"
                },
                "baseline_value": {
                  "$ref": "#/$defs/id"
                },
                "candidate_state_id": {
                  "$ref": "#/$defs/id"
                },
                "candidate_value": {
                  "$ref": "#/$defs/id"
                },
                "rollback_state_id": {
                  "$ref": "#/$defs/id"
                },
                "rollback_value": {
                  "$ref": "#/$defs/id"
                }
              },
              "required": [
                "role_id",
                "path_id",
                "baseline_state_id",
                "baseline_value",
                "candidate_state_id",
                "candidate_value",
                "rollback_state_id",
                "rollback_value"
              ],
              "unevaluatedProperties": false
            }
          },
          "phase_expectations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "phase_id": {
                  "$ref": "#/$defs/id"
                },
                "from_state_id": {
                  "$ref": "#/$defs/id"
                },
                "to_state_id": {
                  "$ref": "#/$defs/id"
                }
              },
              "required": [
                "phase_id",
                "from_state_id",
                "to_state_id"
              ],
              "unevaluatedProperties": false
            }
          },
          "assertion_expectations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "properties": {
                "assertion_id": {
                  "$ref": "#/$defs/id"
                },
                "kind": {
                  "$ref": "#/$defs/id"
                },
                "expected": {
                  "type": [
                    "string",
                    "integer",
                    "boolean"
                  ]
                }
              },
              "required": [
                "assertion_id",
                "kind",
                "expected"
              ],
              "unevaluatedProperties": false
            }
          },
          "rollback_or_compensation": {
            "type": "object",
            "properties": {
              "kind": {
                "$ref": "#/$defs/id"
              },
              "expected_state_id": {
                "$ref": "#/$defs/id"
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "expected_state_id",
              "required"
            ],
            "unevaluatedProperties": false
          },
          "fixture_digest": {
            "$ref": "#/$defs/digest"
          },
          "execution_contract": {
            "type": "object",
            "properties": {
              "contract_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "environment_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "environment_classification": {
                "const": "non-production"
              },
              "authority_kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "impact_roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "minItems": 1,
                "maxItems": 64
              },
              "containment_roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "minItems": 1,
                "maxItems": 64
              },
              "controls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "control_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "kind": {
                      "enum": [
                        "authority",
                        "impact",
                        "containment",
                        "health",
                        "rollback"
                      ]
                    },
                    "path_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "expected_value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  },
                  "required": [
                    "control_id",
                    "kind",
                    "path_id",
                    "expected_value"
                  ],
                  "unevaluatedProperties": false
                },
                "minItems": 5,
                "maxItems": 5
              },
              "minimal_change_budget": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "health_predicates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "predicate_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "target_role": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "field_path": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "minItems": 1,
                      "maxItems": 64
                    },
                    "expected": {
                      "type": [
                        "string",
                        "boolean",
                        "integer",
                        "null"
                      ],
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "predicate_id",
                    "target_role",
                    "field_path",
                    "expected"
                  ],
                  "unevaluatedProperties": false
                },
                "minItems": 1,
                "maxItems": 64
              },
              "ordered_gates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "gate_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "kind": {
                      "enum": [
                        "impact",
                        "health",
                        "rollback"
                      ]
                    }
                  },
                  "required": [
                    "gate_id",
                    "kind"
                  ],
                  "unevaluatedProperties": false
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "contract_id",
              "environment_id",
              "environment_classification",
              "authority_kind",
              "impact_roles",
              "containment_roles",
              "controls",
              "minimal_change_budget",
              "health_predicates",
              "ordered_gates"
            ],
            "unevaluatedProperties": false
          }
        },
        "required": [
          "fixture_id",
          "profile_id",
          "scenario_id",
          "target_roles",
          "phase_expectations",
          "assertion_expectations",
          "rollback_or_compensation",
          "fixture_digest"
        ],
        "unevaluatedProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "registry_id",
    "fixtures"
  ],
  "unevaluatedProperties": false
}
