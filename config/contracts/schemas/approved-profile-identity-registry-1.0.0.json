{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:approved-profile-identity-registry:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "governing_spec_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "profile_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      }
    },
    "registry_digest": {
      "type": "string",
      "minLength": 78,
      "maxLength": 78
    }
  },
  "required": [
    "schema_version",
    "registry_id",
    "governing_spec_sha256",
    "profile_ids",
    "registry_digest"
  ],
  "unevaluatedProperties": false
}
