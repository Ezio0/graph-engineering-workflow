{
  "$id": "urn:gew:schema:installation-approval-challenge:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "challenge_digest": {
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$",
      "type": "string"
    },
    "context_digest": {
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$",
      "type": "string"
    },
    "display_digest": {
      "$comment": "Exact grammar ^sha256:[0-9a-f]{64}$ is enforced by the charged approval record validator.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "envelope_digest": {
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$",
      "type": "string"
    },
    "installation_id": {
      "$comment": "Exact grammar ^[A-Za-z0-9][A-Za-z0-9:._-]{0,127}$ is enforced by the charged approval record validator.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "invocation_nonce": {
      "$comment": "Exact grammar ^[0-9a-f]{32}$ is enforced by the charged approval record validator.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "operation": {
      "const": "install"
    },
    "owner_id": {
      "$comment": "Exact grammar ^(0|[1-9][0-9]{0,19})$ is enforced by the charged approval record validator.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "plan_digest": {
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$",
      "type": "string"
    },
    "policy_digest": {
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$",
      "type": "string"
    },
    "request_id": {
      "$comment": "Exact grammar ^[A-Za-z0-9][A-Za-z0-9:._-]{0,127}$ is enforced by the charged approval record validator.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "installation_id",
    "operation",
    "plan_digest",
    "context_digest",
    "envelope_digest",
    "policy_digest",
    "owner_id",
    "invocation_nonce",
    "display_digest",
    "challenge_digest"
  ],
  "type": "object",
  "unevaluatedProperties": false
}
