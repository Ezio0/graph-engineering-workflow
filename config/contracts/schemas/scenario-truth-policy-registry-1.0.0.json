{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gew:schema:scenario-truth-policy-registry:1.0.0",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$"
    },
    "raw": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "$ref": "#/$defs/id"
    },
    "testability": {
      "type": "object",
      "properties": {
        "cumulative_runtime_limit_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "heartbeat_interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "cumulative_runtime_limit_seconds",
        "heartbeat_interval_seconds"
      ],
      "unevaluatedProperties": false
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "profile_id": {
            "$ref": "#/$defs/id"
          },
          "profile_version": {
            "$ref": "#/$defs/id"
          }
        },
        "required": [
          "profile_id",
          "profile_version"
        ],
        "unevaluatedProperties": false
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "profile_id": {
            "$ref": "#/$defs/id"
          },
          "profile_version": {
            "$ref": "#/$defs/id"
          },
          "scenario_id": {
            "$ref": "#/$defs/id"
          },
          "fixture_id": {
            "$ref": "#/$defs/id"
          },
          "fixture_digest": {
            "$ref": "#/$defs/digest"
          },
          "required_target_roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "ordered_phase_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "required_fact_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "success_outcome": {
            "$ref": "#/$defs/id"
          },
          "blocked_outcome": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/id"
              }
            ]
          },
          "owner_route_policy": {
            "$ref": "#/$defs/id"
          },
          "branch_isolation_policy": {
            "$ref": "#/$defs/id"
          },
          "mutation_budget": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "rollback_required": {
            "type": "boolean"
          },
          "compensation_required": {
            "type": "boolean"
          },
          "row_digest": {
            "$ref": "#/$defs/digest"
          }
        },
        "required": [
          "profile_id",
          "profile_version",
          "scenario_id",
          "fixture_id",
          "fixture_digest",
          "required_target_roles",
          "ordered_phase_ids",
          "required_fact_ids",
          "success_outcome",
          "blocked_outcome",
          "owner_route_policy",
          "branch_isolation_policy",
          "mutation_budget",
          "rollback_required",
          "compensation_required",
          "row_digest"
        ],
        "unevaluatedProperties": false
      }
    },
    "registry_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "required": [
    "schema_version",
    "registry_id",
    "testability",
    "profiles",
    "scenarios",
    "registry_digest"
  ],
  "unevaluatedProperties": false
}
